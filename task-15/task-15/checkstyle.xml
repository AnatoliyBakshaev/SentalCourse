<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>

    <!-- Отключаем проверку на наличие newline в конце файла -->
    <module name="NewlineAtEndOfFile">
        <property name="severity" value="ignore"/>
    </module>

    <!-- Отключаем проверку на package-info.java -->
    <module name="JavadocPackage">
        <property name="severity" value="ignore"/>
    </module>

    <!-- Разрешаем длинные строки (до 120 символов) -->
    <module name="LineLength">
        <property name="max" value="120"/>
    </module>

    <module name="TreeWalker">
        <!-- Разрешаем импорт с * -->
        <module name="AvoidStarImport">
            <property name="severity" value="ignore"/>
        </module>

        <!-- Отключаем требование JavaDoc для переменных -->
        <module name="JavadocVariable">
            <property name="severity" value="ignore"/>
        </module>

        <!-- Отключаем требование JavaDoc для методов -->
        <module name="MissingJavadocMethod">
            <property name="severity" value="ignore"/>
        </module>

        <!-- Смягчаем правила для имен констант -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>

        <!-- Отключаем требование final для параметров -->
        <module name="FinalParameters">
            <property name="severity" value="ignore"/>
        </module>

        <!-- Ослабляем проверку на утилитные классы -->
        <module name="HideUtilityClassConstructor">
            <property name="severity" value="ignore"/>
        </module>

        <!-- Отключаем требование JavaDoc для публичных методов -->
        <module name="JavadocMethod">
            <property name="severity" value="ignore"/>
        </module>

        <!-- Отключаем проверку на магические числа -->
        <module name="MagicNumber">
            <property name="severity" value="ignore"/>
        </module>
    </module>
</module>